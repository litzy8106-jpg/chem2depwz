// ---------- router ----------
const VIEWS=["map","discussion","compare","remember","visualize","past","quiz"];
function route(){
  let h=(location.hash||"#map").slice(1);let target=null,view=h;
  if(!VIEWS.includes(h)){target=document.getElementById(h);const v=target&&target.closest(".view");view=v?v.id.replace("view-",""):"map"}
  VIEWS.forEach(v=>{$("view-"+v).hidden=v!==view});
  document.querySelectorAll(".tabs a").forEach(a=>{if(a.dataset.view===view)a.setAttribute("aria-current","page");else a.removeAttribute("aria-current")});
  if(target&&!VIEWS.includes(h)){requestAnimationFrame(()=>target.scrollIntoView({block:"start"}))}else window.scrollTo(0,0);
  if(view==="quiz")renderQ();
  if(view==="remember"){drawWork();drawHeat();drawG()}
  if(view==="visualize")drawViz();
}
window.addEventListener("hashchange",route);
