const store={get(k,d){try{const v=localStorage.getItem(k);return v==null?d:JSON.parse(v)}catch(e){return d}},set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
const KW=1e-14;
function sci(x,d=1){if(!isFinite(x)||x<=0)return "0";const e=Math.floor(Math.log10(x));let m=x/10**e;if(+m.toFixed(d)>=10){m/=10;return m.toFixed(d)+"×10"+sup(e+1)}return m.toFixed(d)+"×10"+sup(e)}
function sup(n){const m={"-":"⁻","0":"⁰","1":"¹","2":"²","3":"³","4":"⁴","5":"⁵","6":"⁶","7":"⁷","8":"⁸","9":"⁹"};return String(n).split("").map(c=>m[c]).join("")}
const clamp=(x,a,b)=>Math.max(a,Math.min(b,x));
// fraction of each protonation state for acid with constants K (array), at [H+]=h
function alphas(K,h){const n=K.length;const t=[];let p=1;for(let j=0;j<=n;j++){if(j>0)p*=K[j-1];t.push(Math.pow(h,n-j)*p)}const D=t.reduce((a,b)=>a+b,0);return t.map(x=>x/D)}
function nbar(K,h){return alphas(K,h).reduce((s,a,j)=>s+j*a,0)}
function solvePH(f){let lo=-2,hi=16;for(let i=0;i<80;i++){const m=(lo+hi)/2;if(f(10**-m)>0)lo=m;else hi=m}return (lo+hi)/2} // f(h) decreasing in pH: >0 means pH too low
// universal-indicator color
const PHC=[[0,[215,38,61]],[3,[244,96,54]],[5,[242,177,52]],[7,[63,163,77]],[9,[46,134,171]],[11,[59,76,202]],[14,[106,44,145]]];
function phColor(p){p=clamp(p,0,14);for(let i=1;i<PHC.length;i++){if(p<=PHC[i][0]){const [a,ca]=PHC[i-1],[b,cb]=PHC[i];const t=(p-a)/(b-a);return "rgb("+ca.map((v,k)=>Math.round(v+(cb[k]-v)*t)).join(",")+")"}}return "rgb(106,44,145)"}

