const PAST=[
{g:"pq",id:"P1",src:"Past quiz item 1",topic:"First law",q:"If 1500 cal of heat is added to a system while the system does work equivalent to 2500 cal by expanding against the surrounding atmosphere, what is the value of ΔE for the system?",ans:-1000,unit:"cal",tol:.01,
 steps:["Assign signs from the system's point of view. Heat <i>added</i> to the system: q = +1500 cal. Work done <i>by</i> the system (expansion): w = −2500 cal.","Apply the first law: ΔE = q + w = 1500 + (−2500).","ΔE = <b>−1000 cal</b>."],
 why:"The system spent more energy pushing back the atmosphere than it received as heat, so its internal energy dropped. The words \"added\" and \"does work\" decide the signs; get those right and the arithmetic is one line."},
{g:"tw",id:"T1a",src:"Twin of past item 1",topic:"First law",q:"A system absorbs 820 J of heat while the surroundings compress it, doing 1350 J of work on it. What is ΔE?",ans:2170,unit:"J",tol:.01,
 steps:["Heat absorbed: q = +820 J. Work done <i>on</i> the system (compression): w = +1350 J.","ΔE = 820 + 1350 = <b>+2170 J</b>."],
 why:"Both energy flows go into the system, so both are positive and ΔE is their sum."},
{g:"tw",id:"T1b",src:"Twin of past item 1",topic:"First law",q:"A gas releases 2.40 kJ of heat while it is compressed by 1.15 kJ of work. What is ΔE of the gas?",ans:-1.25,unit:"kJ",tol:.01,
 steps:["Heat released: q = −2.40 kJ. Compression means work is done on the gas: w = +1.15 kJ.","ΔE = −2.40 + 1.15 = <b>−1.25 kJ</b>."],
 why:"Energy entered as work but more left as heat, so the net change is negative. Mixed signs are where careless errors happen; write each sign down before adding."},
{g:"pq",id:"P2",src:"Past quiz item 2",topic:"Phase changes",q:"Calculate the enthalpy of sublimation of 100 g of carbon dioxide at 183 K, if ΔH<sub>sub</sub> = 3.87 kcal/mol.",ans:8.80,unit:"kcal",tol:.01,
 steps:["Convert mass to moles: n = 100 g ÷ 44.01 g/mol = 2.27 mol CO<sub>2</sub>.","Enthalpy is extensive, so scale the molar value: ΔH = n × ΔH<sub>sub</sub> = 2.27 × 3.87.","ΔH = <b>8.80 kcal</b> (absorbed; sublimation is endothermic)."],
 why:"ΔH<sub>sub</sub> is given per mole, but the question asks about 100 g. The only real step is grams → moles. The temperature (183 K) is just where dry ice sublimes; it is not used in the calculation."},
{g:"tw",id:"T2a",src:"Twin of past item 2",topic:"Phase changes",q:"How much heat is needed to vaporize 50.0 g of water at 100 °C? ΔH<sub>vap</sub> = 40.7 kJ/mol.",ans:112.9,unit:"kJ",tol:.01,
 steps:["n = 50.0 ÷ 18.02 = 2.775 mol.","q = 2.775 × 40.7 = <b>113 kJ</b>."],
 why:"Same pattern as the past item: moles × molar enthalpy. Temperature stays at 100 °C the whole time; the heat goes into separating molecules."},
{g:"tw",id:"T2b",src:"Twin of past item 2",topic:"Phase changes",q:"What is q when 25.0 g of liquid water freezes at 0 °C? ΔH<sub>fus</sub> = 6.01 kJ/mol. (Give the sign.)",ans:-8.34,unit:"kJ",tol:.01,
 steps:["n = 25.0 ÷ 18.02 = 1.387 mol.","Freezing is the reverse of fusion, so ΔH<sub>freezing</sub> = −6.01 kJ/mol.","q = 1.387 × (−6.01) = <b>−8.34 kJ</b>."],
 why:"Reversing a process flips the sign of ΔH (Hess's law). Freezing releases exactly the heat that melting absorbs."},
{g:"pq",id:"P3",src:"Past quiz item 3",topic:"Heats of formation",q:"Calculate ΔH°<sub>f</sub> of C<sub>6</sub>H<sub>12</sub>O<sub>6</sub>(s) from: ΔH<sub>combustion</sub> of C<sub>6</sub>H<sub>12</sub>O<sub>6</sub>(s) = −2816 kJ/mol; ΔH°<sub>f</sub> of CO<sub>2</sub>(g) = −393.5 kJ/mol; ΔH°<sub>f</sub> of H<sub>2</sub>O(l) = −285.9 kJ/mol.",ans:-1260,unit:"kJ/mol",tol:.005,
 steps:["Write the balanced combustion: C<sub>6</sub>H<sub>12</sub>O<sub>6</sub>(s) + 6O<sub>2</sub>(g) → 6CO<sub>2</sub>(g) + 6H<sub>2</sub>O(l), ΔH = −2816 kJ.","Products minus reactants: −2816 = [6(−393.5) + 6(−285.9)] − [ΔH°<sub>f</sub>(glucose) + 6(0)].","Products sum: −2361 − 1715.4 = −4076.4 kJ. So −2816 = −4076.4 − ΔH°<sub>f</sub>(glucose).","ΔH°<sub>f</sub>(glucose) = −4076.4 + 2816 = <b>−1260 kJ/mol</b>."],
 why:"The same \"products minus reactants\" equation works when the unknown is a reactant. O<sub>2</sub> is an element in its standard state, so its ΔH°<sub>f</sub> is zero. Balancing the equation first is essential: the 6s come from it."},
{g:"tw",id:"T3a",src:"Twin of past item 3",topic:"Heats of formation",q:"ΔH<sub>combustion</sub> of ethanol, C<sub>2</sub>H<sub>5</sub>OH(l), is −1367 kJ/mol. With ΔH°<sub>f</sub> CO<sub>2</sub>(g) = −393.5 and H<sub>2</sub>O(l) = −285.8 kJ/mol, find ΔH°<sub>f</sub> of ethanol.",ans:-277.4,unit:"kJ/mol",tol:.01,
 steps:["C<sub>2</sub>H<sub>5</sub>OH(l) + 3O<sub>2</sub> → 2CO<sub>2</sub> + 3H<sub>2</sub>O(l).","−1367 = [2(−393.5) + 3(−285.8)] − ΔH°<sub>f</sub>(ethanol) = −1644.4 − ΔH°<sub>f</sub>.","ΔH°<sub>f</sub>(ethanol) = −1644.4 + 1367 = <b>−277.4 kJ/mol</b>."],
 why:"Balance first (2 C → 2 CO<sub>2</sub>, 6 H → 3 H<sub>2</sub>O), then solve the products-minus-reactants equation for the one unknown."},
{g:"tw",id:"T3b",src:"Twin of past item 3",topic:"Heats of formation",q:"Find ΔH for the combustion of propane, C<sub>3</sub>H<sub>8</sub>(g) + 5O<sub>2</sub>(g) → 3CO<sub>2</sub>(g) + 4H<sub>2</sub>O(l). ΔH°<sub>f</sub>: C<sub>3</sub>H<sub>8</sub> −103.8, CO<sub>2</sub> −393.5, H<sub>2</sub>O(l) −285.8 kJ/mol.",ans:-2219.9,unit:"kJ",tol:.005,
 steps:["Products: 3(−393.5) + 4(−285.8) = −1180.5 − 1143.2 = −2323.7 kJ.","Reactants: −103.8 + 5(0) = −103.8 kJ.","ΔH = −2323.7 − (−103.8) = <b>−2219.9 kJ</b>."],
 why:"This is the forward version of the past item. With liquid water the answer is about −2220 kJ; your handout's −2043 kJ corresponds to water as a gas, which is why the phase label matters."},
{g:"pq",id:"P4",src:"Past quiz item 4",topic:"Gibbs free energy",q:"For the reaction 2A(g) + B(g) → 2D(g), ΔE°<sub>298K</sub> = −2.50 kcal and ΔS°<sub>298K</sub> = −10.5 cal/K. Calculate ΔG°<sub>298K</sub> (in cal) and predict whether the reaction may occur spontaneously. Assume ideal behavior; R = 1.987 cal/mol·K.",ans:36.9,unit:"cal",tol:.02,
 steps:["ΔG uses ΔH, not ΔE, so convert first. Δn<sub>g</sub> = 2 − (2 + 1) = −1.","ΔH = ΔE + Δn<sub>g</sub>RT = −2500 cal + (−1)(1.987)(298) = −2500 − 592 = −3092 cal.","ΔG = ΔH − TΔS = −3092 − (298)(−10.5) = −3092 + 3129.","ΔG = <b>+36.9 cal</b>, positive, so the reaction is <b>nonspontaneous</b> at 298 K."],
 why:"Two traps: forgetting to convert ΔE → ΔH (which gives +629 cal), and mixing kcal with cal. Here ΔH and −TΔS nearly cancel, so the small Δn<sub>g</sub>RT correction is exactly what decides the sign."},
{g:"tw",id:"T4a",src:"Twin of past item 4",topic:"Gibbs free energy",q:"For A(g) → 2B(g) at 298 K, ΔE° = +3.20 kcal and ΔS° = +18.0 cal/K. Find ΔG° in cal (R = 1.987 cal/mol·K). Is it spontaneous?",ans:-1572,unit:"cal",tol:.01,
 steps:["Δn<sub>g</sub> = 2 − 1 = +1.","ΔH = 3200 + (1)(1.987)(298) = 3200 + 592 = 3792 cal.","ΔG = 3792 − (298)(18.0) = 3792 − 5364 = <b>−1572 cal</b>, so spontaneous."],
 why:"Endothermic but entropy-driven: one gas molecule becomes two, and at 298 K the TΔS term outweighs ΔH."},
{g:"tw",id:"T4b",src:"Twin of past item 4",topic:"Gibbs free energy",q:"For N<sub>2</sub>(g) + 3H<sub>2</sub>(g) → 2NH<sub>3</sub>(g) at 298 K, ΔE° = −87.4 kJ and ΔS° = −198.3 J/K. Find ΔG° in kJ.",ans:-33.3,unit:"kJ",tol:.01,
 steps:["Δn<sub>g</sub> = 2 − 4 = −2. ΔH = −87.4 + (−2)(8.314 × 10<sup>−3</sup>)(298) = −87.4 − 4.96 = −92.4 kJ.","ΔG = −92.4 − (298)(−0.1983) = −92.4 + 59.1 = <b>−33.3 kJ</b>, so spontaneous at 298 K."],
 why:"Convert ΔS to kJ/K before multiplying by T. Both ΔH and ΔS are negative, so this reaction becomes nonspontaneous above about 466 K (ΔH/ΔS)."},
{g:"pq",id:"P5",src:"Past quiz item 5",topic:"Enthalpy",q:"For the reaction B<sub>2</sub>H<sub>6</sub>(g) + 3O<sub>2</sub>(g) → B<sub>2</sub>O<sub>3</sub>(s) + 3H<sub>2</sub>O(l), ΔE° is −2143.2 kJ. Calculate ΔH° for the reaction.",ans:-2153.1,unit:"kJ",tol:.0005,
 steps:["Count gas moles only. Reactants: 1 B<sub>2</sub>H<sub>6</sub> + 3 O<sub>2</sub> = 4. Products: B<sub>2</sub>O<sub>3</sub>(s) and H<sub>2</sub>O(l) are not gases = 0. Δn<sub>g</sub> = −4.","ΔH = ΔE + Δn<sub>g</sub>RT = −2143.2 + (−4)(8.314 × 10<sup>−3</sup> kJ/mol·K)(298 K) = −2143.2 − 9.9.","ΔH = <b>−2153.1 kJ</b>."],
 why:"Use R in kJ (8.314 × 10<sup>−3</sup>) so the units match. Gas moles decrease, so the atmosphere does work on the system and ΔH comes out more negative than ΔE."},
{g:"tw",id:"T5a",src:"Twin of past item 5",topic:"Enthalpy",q:"For CH<sub>4</sub>(g) + 2O<sub>2</sub>(g) → CO<sub>2</sub>(g) + 2H<sub>2</sub>O(l), ΔE° = −885.4 kJ at 298 K. Find ΔH°.",ans:-890.4,unit:"kJ",tol:.0005,
 steps:["Gas moles: reactants 3, products 1 (water is liquid). Δn<sub>g</sub> = −2.","ΔH = −885.4 + (−2)(8.314 × 10<sup>−3</sup>)(298) = −885.4 − 4.96 = <b>−890.4 kJ</b>."],
 why:"The textbook ΔH of methane combustion (−890 kJ) comes out of this correction. Liquid water does not count toward Δn<sub>g</sub>."},
{g:"tw",id:"T5b",src:"Twin of past item 5",topic:"Enthalpy",q:"For C(graphite) + O<sub>2</sub>(g) → CO<sub>2</sub>(g), ΔE° = −393.5 kJ. Find ΔH°.",ans:-393.5,unit:"kJ",tol:.0005,
 steps:["Gas moles: reactants 1 (O<sub>2</sub>; graphite is solid), products 1. Δn<sub>g</sub> = 0.","ΔH = ΔE + 0 = <b>−393.5 kJ</b>."],
 why:"When the gas moles don't change, there is no PΔV work at constant pressure, so ΔH = ΔE exactly."},
{g:"hx",id:"H1",src:"Handout · system types",topic:"Systems",q:"Zn(s) and an aqueous solution of HCl are mixed in an open flask. Which is the system, which are the surroundings, and what type of system is it?",ans:null,
 steps:["System: the reacting Zn and HCl solution inside the flask.","Surroundings: everything else: the flask walls, the air, the thermometer, you.","The flask is open: H<sub>2</sub> gas (matter) escapes and heat (energy) is exchanged, so it is an <b>open system</b>."],
 why:"Classify by what crosses the boundary. Matter and energy → open. Energy only (stoppered flask) → closed. Neither → isolated."},
{g:"hx",id:"H2",src:"Handout · Question 1",topic:"First law",q:"A system receives 575 J of heat and delivers 875 J of work to its surroundings. What is the change in internal energy?",ans:-300,unit:"J",tol:.01,
 steps:["q = +575 J (received). w = −875 J (delivered by the system).","ΔE = 575 + (−875) = <b>−300 J</b>."],why:"More energy left as work than entered as heat."},
{g:"hx",id:"H3",src:"Handout · Question 2",topic:"First law",q:"Expanding gases in a car engine do 450 J of work on the pistons, and the engine loses 330 J to the surroundings as heat. Calculate ΔE in kilocalories (1 kcal = 4.184 kJ).",ans:-0.186,unit:"kcal",tol:.01,
 steps:["System = gasoline reaction and products. q = −330 J, w = −450 J.","ΔE = −780 J.","−780 J × (1 kJ/1000 J) × (1 kcal/4.184 kJ) = <b>−0.186 kcal</b>."],why:"Both flows leave the system, so both are negative. Then convert J → kJ → kcal."},
{g:"hx",id:"H4",src:"Handout · heat of formation",topic:"Heats of formation",q:"Calculate the enthalpy of combustion of C<sub>2</sub>H<sub>4</sub>(g). ΔH°<sub>f</sub>: C<sub>2</sub>H<sub>4</sub>(g) = 12.4, CO<sub>2</sub>(g) = −94.0, H<sub>2</sub>O(l) = −68.3 kcal/mol.",ans:-337,unit:"kcal",tol:.005,
 steps:["C<sub>2</sub>H<sub>4</sub> + 3O<sub>2</sub> → 2CO<sub>2</sub> + 2H<sub>2</sub>O(l).","ΔH = [2(−94.0) + 2(−68.3)] − [12.4 + 3(0)] = −324.6 − 12.4 = <b>−337 kcal</b>."],why:"Products minus reactants, each multiplied by its coefficient; O<sub>2</sub> contributes zero."},
{g:"hx",id:"H5",src:"Handout · Hess's law",topic:"Hess's law",q:"Combustion of 1.00 mol C<sub>2</sub>H<sub>6</sub> releases 368.4 kcal, of 1.00 mol C<sub>2</sub>H<sub>4</sub> releases 337.2 kcal, and H<sub>2</sub> + ½O<sub>2</sub> → H<sub>2</sub>O has ΔH = −68.32 kcal. Find ΔH for C<sub>2</sub>H<sub>4</sub>(g) + H<sub>2</sub>(g) → C<sub>2</sub>H<sub>6</sub>(g).",ans:-37.1,unit:"kcal",tol:.01,
 steps:["Reverse the C<sub>2</sub>H<sub>6</sub> combustion so C<sub>2</sub>H<sub>6</sub> is a product: +368.4 kcal.","Keep C<sub>2</sub>H<sub>4</sub> combustion (−337.2) and H<sub>2</sub> combustion (−68.32).","CO<sub>2</sub>, H<sub>2</sub>O and O<sub>2</sub> cancel. ΔH = 368.4 − 337.2 − 68.32 = <b>−37.1 kcal</b>."],why:"\"Releases 368.4 kcal\" means ΔH = −368.4; reversing it flips the sign to +368.4."},
{g:"hx",id:"H6",src:"Handout · bond enthalpy",topic:"Bond enthalpy",q:"Estimate ΔH for C<sub>3</sub>H<sub>8</sub> + 5O<sub>2</sub> → 3CO<sub>2</sub> + 4H<sub>2</sub>O from bond enthalpies: C–H 413, C–C 347, O=O 498, C=O 805, O–H 464 kJ/mol.",ans:-2054,unit:"kJ",tol:.005,
 steps:["Broken: 8 C–H + 2 C–C + 5 O=O = 3304 + 694 + 2490 = 6488 kJ.","Formed: 6 C=O + 8 O–H = 4830 + 3712 = 8542 kJ.","ΔH = 6488 − 8542 = <b>−2054 kJ</b>."],why:"Count bonds from structures: propane has 8 C–H and 2 C–C; each CO<sub>2</sub> has two C=O; each H<sub>2</sub>O has two O–H."},
{g:"hx",id:"H7",src:"Handout · Born–Haber",topic:"Born–Haber",q:"Find ΔH°<sub>f</sub> of NaCl(s): ΔH<sub>sub</sub>(Na) = +108, IE(Na) = +496, ΔH<sub>diss</sub>(½Cl<sub>2</sub>) = +122, EA(Cl) = −349, U = −788 kJ.",ans:-411,unit:"kJ/mol",tol:.005,
 steps:["ΔH°<sub>f</sub> = ΔH<sub>sub</sub> + IE + ΔH<sub>diss</sub> + EA + U.","= 108 + 496 + 122 − 349 − 788 = <b>−411 kJ/mol</b>."],why:"Every step from Na(s) + ½Cl<sub>2</sub>(g) to NaCl(s) adds up because H is a state function."},
{g:"hx",id:"H8",src:"Handout · irreversible work",topic:"Work",q:"1 mol of ideal gas at 2 atm expands from 10.0 L to 14.0 L against a constant external pressure of 1 atm. Find w (irreversible), in J.",ans:-405.3,unit:"J",tol:.01,
 steps:["w = −P<sub>ext</sub>(V<sub>2</sub> − V<sub>1</sub>) = −(1 atm)(4.0 L) = −4.0 L·atm.","× 8.314 J / 0.08205 L·atm = <b>−405.3 J</b>."],why:"Use the outside pressure, not the gas's 2 atm."},
{g:"hx",id:"H9",src:"Handout · reversible work",topic:"Work",q:"Same gas (1 mol, 2 atm, 10.0 L → 14.0 L) expands reversibly and isothermally. Find w, in J.",ans:-682,unit:"J",tol:.01,
 steps:["T = PV/nR = (2)(10.0)/(1 × 0.08205) = 243.8 K.","w = −nRT ln(V<sub>2</sub>/V<sub>1</sub>) = −(1)(8.314)(243.8) ln 1.4 = <b>−682 J</b>."],why:"Reversible work is the maximum: 682 J beats 405 J for the same expansion."},
{g:"hx",id:"H10",src:"Handout · Worked Example 1",topic:"Calorimetry",q:"10.3 mg benzoic acid (MW 122) burns in a bomb calorimeter (C = 0.22 kJ/°C); T rises 24.5 → 25.1 °C. Find ΔE in kJ/mol.",ans:-1563,unit:"kJ/mol",tol:.01,
 steps:["q<sub>v</sub> = −(0.22)(0.6) = −0.132 kJ.","moles = 0.0103 g ÷ 122 g/mol = 8.44 × 10<sup>−5</sup> mol.","ΔE = −0.132 ÷ 8.44 × 10<sup>−5</sup> = <b>−1563 kJ/mol</b>. (Then ΔH = −1563 + (−0.5)(8.314 × 10<sup>−3</sup>)(298) = −1564 kJ/mol.)"],why:"Bomb → constant volume → q<sub>v</sub> = ΔE. A temperature rise means the reaction released heat, so the sign is negative."},
{g:"hx",id:"H11",src:"Handout · Worked Example 2",topic:"Calorimetry",q:"0.14 g CH<sub>3</sub>OH burned at constant pressure raises the calorimeter (C<sub>p</sub> = 1.5 kJ/°C) by 0.222 °C. Find ΔH in kJ/mol.",ans:-76,unit:"kJ/mol",tol:.02,
 steps:["q<sub>p</sub> = −(1.5)(0.222) = −0.333 kJ.","moles = 0.14 ÷ 32 = 4.38 × 10<sup>−3</sup> mol.","ΔH = −0.333 ÷ 4.38 × 10<sup>−3</sup> = <b>−76 kJ/mol</b>."],why:"Constant pressure → q<sub>p</sub> = ΔH. (The accepted value is about −726 kJ/mol, so treat the handout's numbers as a method drill.)"},
{g:"hx",id:"H12",src:"Handout · Worked Example 3",topic:"Phase changes",q:"1.0 kg of liquid water is vaporized at 100 °C and 1 atm (ΔH<sub>vap</sub> = 40.7 kJ/mol). Find ΔE in kJ.",ans:2088,unit:"kJ",tol:.01,
 steps:["n = 1000/18 = 55.6 mol. q<sub>p</sub> = ΔH = 55.6 × 40.7 = 2260 kJ.","w ≈ −nRT = −(55.6)(8.314)(373) = −172 kJ.","ΔE = q + w = 2260 − 172 = <b>2088 kJ</b>."],why:"Part of the heat is used to push back the atmosphere as the vapor forms, so ΔE is smaller than ΔH."},
{g:"hx",id:"H13",src:"Handout · entropy, physical change",topic:"Entropy",q:"Calculate ΔS for the vaporization of water at 100 °C, ΔH<sub>vap</sub> = 40.7 kJ/mol.",ans:109.1,unit:"J/mol·K",tol:.01,
 steps:["ΔS = ΔH<sub>vap</sub>/T = 40 700 J/mol ÷ 373 K = <b>109.1 J/mol·K</b>."],why:"Convert kJ → J and °C → K."},
{g:"hx",id:"H14",src:"Handout · entropy, reaction",topic:"Entropy",q:"Calculate ΔS° for O<sub>2</sub>(g) + 2H<sub>2</sub>(g) → 2H<sub>2</sub>O(g). S°: O<sub>2</sub> 205.0, H<sub>2</sub> 130.6, H<sub>2</sub>O(g) 188.7 J/mol·K.",ans:-88.8,unit:"J/K",tol:.01,
 steps:["ΔS° = 2(188.7) − [205.0 + 2(130.6)] = 377.4 − 466.2 = <b>−88.8 J/K</b>."],why:"Three moles of gas become two, so entropy falls."},
{g:"hx",id:"H15",src:"Handout · entropy, reaction",topic:"Entropy",q:"Calculate ΔS° for CH<sub>4</sub>(g) + 2O<sub>2</sub>(g) → CO<sub>2</sub>(g) + 2H<sub>2</sub>O(l). S°: CH<sub>4</sub> 186.2, O<sub>2</sub> 205.0, CO<sub>2</sub> 213.6, H<sub>2</sub>O(l) 69.9 J/mol·K.",ans:-242.8,unit:"J/K",tol:.01,
 steps:["Products: 213.6 + 2(69.9) = 353.4. Reactants: 186.2 + 2(205.0) = 596.2.","ΔS° = 353.4 − 596.2 = <b>−242.8 J/K</b>."],why:"Note that S° of O<sub>2</sub> is not zero, unlike its ΔH°<sub>f</sub>."},
{g:"hx",id:"H16",src:"Handout · Gibbs free energy",topic:"Gibbs free energy",q:"Determine ΔG for 2H<sub>2</sub>O(l) → 2H<sub>2</sub>(g) + O<sub>2</sub>(g) at 25 °C, given ΔS° = 326.4 J/K and ΔH° = 571.6 kJ.",ans:474.3,unit:"kJ",tol:.005,
 steps:["T = 298 K; ΔS = 0.3264 kJ/K.","ΔG = 571.6 − (298)(0.3264) = 571.6 − 97.3 = <b>474.3 kJ</b>, so nonspontaneous."],why:"Convert ΔS to kJ/K; forgetting this gives a nonsense ΔG of about −97 000."},
{g:"pq",id:"EQP2",src:"Past quiz · Ionic Equilibria (essay, ≤ 50 words)",topic:"Combining K",q:"When two equilibrium reactions are combined (added), their equilibrium constants are multiplied: AgBr(s) ⇌ Ag<sup>+</sup> + Br<sup>−</sup> (K<sub>sp</sub>) plus Ag<sup>+</sup> + 2NH<sub>3</sub> ⇌ Ag(NH<sub>3</sub>)<sub>2</sub><sup>+</sup> (K<sub>f</sub>) gives AgBr(s) + 2NH<sub>3</sub> ⇌ Ag(NH<sub>3</sub>)<sub>2</sub><sup>+</sup> + Br<sup>−</sup> (K<sub>sp</sub> × K<sub>f</sub>). Explain why. Hint: recall the relationship between Gibbs free energy and K.",ans:null,
 steps:["Model answer: ΔG° = −RT ln K, and ΔG° values of added reactions add (G is a state function). So −RT ln K<sub>overall</sub> = −RT(ln K<sub>sp</sub> + ln K<sub>f</sub>). Since ln a + ln b = ln(ab), K<sub>overall</sub> = K<sub>sp</sub> × K<sub>f</sub>. (≈ 45 words)"],
 why:"The key ideas a grader looks for: (1) ΔG° is additive, (2) ΔG° = −RT ln K, (3) the log rule turns a sum of logs into a product. Don't write \"K<sub>sp</sub> + K<sub>f</sub>\" inside the ln; it is ln K<sub>sp</sub> + ln K<sub>f</sub>."},
{g:"tw",id:"EQT2a",src:"Twin of past item 2",topic:"Combining K",q:"A ⇌ B has K<sub>1</sub> = 2.0 × 10<sup>3</sup> and B ⇌ C has K<sub>2</sub> = 5.0 × 10<sup>−2</sup>. What is K for A ⇌ C?",ans:100,unit:"",tol:.01,
 steps:["Adding the equations cancels B: K = K<sub>1</sub> × K<sub>2</sub> = (2.0 × 10<sup>3</sup>)(5.0 × 10<sup>−2</sup>) = <b>1.0 × 10<sup>2</sup></b>."],why:"Added reactions → multiplied constants (ΔG° values add)."},
{g:"tw",id:"EQT2b",src:"Twin of past item 2",topic:"Combining K",q:"Using K<sub>1</sub> = 2.0 × 10<sup>3</sup> for A ⇌ B, find K for 2B ⇌ 2A.",ans:2.5e-7,unit:"",tol:.01,
 steps:["Reverse: B ⇌ A has K = 1/(2.0 × 10<sup>3</sup>) = 5.0 × 10<sup>−4</sup>.","Double: K = (5.0 × 10<sup>−4</sup>)<sup>2</sup> = <b>2.5 × 10<sup>−7</sup></b>."],why:"Reversing negates ΔG° (→ 1/K); doubling doubles ΔG° (→ K<sup>2</sup>)."},
{g:"pq",id:"EQP3",src:"Past quiz · Le Châtelier lab (cobalt complex)",topic:"Le Châtelier",q:"(1) Can we use NaCl or KCl instead of HCl? Why? (2) Why do you think HCl was used in this experiment? (Short but concise answers.)",ans:null,
 steps:["(1) In principle yes: NaCl and KCl also supply Cl<sup>−</sup>, the common ion that drives [Co(H<sub>2</sub>O)<sub>6</sub>]<sup>2+</sup> (pink) → [CoCl<sub>4</sub>]<sup>2−</sup> (blue). In practice the shift is much weaker, because their solubility limits how high [Cl<sup>−</sup>] can get and solids dissolve slowly.","(2) Concentrated HCl (about 12 M) delivers a very high [Cl<sup>−</sup>] in a few drops, without adding much water (water itself pushes the equilibrium back to pink). So the color change is fast and obvious."],
 why:"The point being tested: what matters is the Cl<sup>−</sup> ion (Le Châtelier / common ion), not the H<sup>+</sup>. HCl is simply the most concentrated, convenient source of Cl<sup>−</sup>."},
{g:"pq",id:"EQP4",src:"Past quiz · Le Châtelier lab (cobalt complex)",topic:"Le Châtelier",q:"Give ONE practical application of the cobalt complex equilibrium system. (Hint: what specific device can be made using this system?)",ans:null,txt:["humidity indicator","moisture indicator","hygrometer","humidity sensor","cobalt chloride paper","silica gel indicator","indicating silica gel","water indicator","humidity indicator card","moisture detector"],show:"Humidity (moisture) indicator",
 steps:["A <b>humidity / moisture indicator</b>: cobalt chloride paper, humidity indicator cards, or the blue indicating silica gel in packets.","Dry → blue ([CoCl<sub>4</sub>]<sup>2−</sup>); moist → pink ([Co(H<sub>2</sub>O)<sub>6</sub>]<sup>2+</sup>), because absorbed water shifts the equilibrium left."],
 why:"Water is a product of the forward reaction, so the amount of moisture in the air sets the position of the equilibrium and therefore the color."},
{g:"pq",id:"EQP5",src:"Past quiz · Le Châtelier lab (cobalt complex)",topic:"Le Châtelier",q:"Reaction A: [Co(H<sub>2</sub>O)<sub>6</sub>]<sup>2+</sup> + 4Cl<sup>−</sup> + heat ⇌ [CoCl<sub>4</sub>]<sup>2−</sup> + 6H<sub>2</sub>O. Reaction B: [Co(H<sub>2</sub>O)<sub>6</sub>]<sup>2+</sup> + 4Cl<sup>−</sup> ⇌ [CoCl<sub>4</sub>]<sup>2−</sup> + 6H<sub>2</sub>O + heat. Which correctly describes the system, given that heating turns the solution blue and cooling turns it pink? Type A or B.",ans:null,txt:["a","reaction a"],show:"Reaction A",
 steps:["Heating favors the blue [CoCl<sub>4</sub>]<sup>2−</sup> side, so the forward reaction must absorb heat.","Heat is a reactant → endothermic forward reaction → <b>Reaction A</b>."],
 why:"By Le Châtelier, adding heat shifts the equilibrium toward the side that consumes heat. Since the product side appears on heating, heat must be written with the reactants."},
{g:"tw",id:"EQT5",src:"Twin of past item 5",topic:"Le Châtelier",q:"A sealed tube of N<sub>2</sub>O<sub>4</sub>(g) ⇌ 2NO<sub>2</sub>(g) turns darker brown (more NO<sub>2</sub>) in hot water. Is the forward reaction endothermic or exothermic?",ans:null,txt:["endothermic","endo"],show:"Endothermic",
 steps:["Heating increases NO<sub>2</sub> (the product), so the forward reaction consumes heat: <b>endothermic</b> (ΔH ≈ +57 kJ).","Consequence: K increases with temperature for this reaction."],why:"Same logic as the cobalt item: the side that grows on heating is the endothermic side."},
{g:"hx",id:"EQH1",src:"Chemical Equilibrium · Question 1b",topic:"K<sub>c</sub> ↔ K<sub>p</sub>",q:"For the Haber–Bosch process N<sub>2</sub>(g) + 3H<sub>2</sub>(g) ⇌ 2NH<sub>3</sub>(g) at 25 °C, K<sub>c</sub> = 3.5 × 10<sup>8</sup>. What is K<sub>p</sub>?",ans:5.8e5,unit:"",tol:.02,
 steps:["Δn = 2 − (1 + 3) = −2; T = 298 K.","K<sub>p</sub> = K<sub>c</sub>(RT)<sup>−2</sup> = (3.5 × 10<sup>8</sup>)(0.0821 × 298)<sup>−2</sup> = <b>5.8 × 10<sup>5</sup></b>."],why:"Gas moles decrease, so K<sub>p</sub> &lt; K<sub>c</sub>."},
{g:"hx",id:"EQH2",src:"Chemical Equilibrium · Question 2",topic:"Mass action",q:"2A(aq) + 3B(aq) ⇌ C(aq) + 2D(aq); at equilibrium [A] = 1 M, [B] = 2 M, [C] = 3 M, [D] = 4 M. Find K<sub>c</sub>.",ans:6,unit:"",tol:.01,
 steps:["K<sub>c</sub> = [C][D]<sup>2</sup>/[A]<sup>2</sup>[B]<sup>3</sup> = (3)(16)/(1)(8) = <b>6</b>."],why:"Every concentration is raised to its coefficient."},
{g:"hx",id:"EQH3",src:"Chemical Equilibrium · Question 3",topic:"K<sub>c</sub> ↔ K<sub>p</sub>",q:"2H<sub>2</sub>(g) + O<sub>2</sub>(g) ⇌ 2H<sub>2</sub>O(g) at 3000 K with P(H<sub>2</sub>O) = 1.0 atm, P(H<sub>2</sub>) = 1.5 × 10<sup>−3</sup> atm, P(O<sub>2</sub>) = 7.6 × 10<sup>−4</sup> atm. Find K<sub>c</sub>.",ans:1.4e11,unit:"",tol:.05,
 steps:["K<sub>p</sub> = 1.0<sup>2</sup>/[(1.5 × 10<sup>−3</sup>)<sup>2</sup>(7.6 × 10<sup>−4</sup>)] = 5.8 × 10<sup>8</sup>.","Δn = −1: K<sub>c</sub> = K<sub>p</sub>(RT) = (5.8 × 10<sup>8</sup>)(0.0821)(3000) = <b>1.4 × 10<sup>11</sup></b>."],why:"Rearranging K<sub>p</sub> = K<sub>c</sub>(RT)<sup>−1</sup> gives K<sub>c</sub> = K<sub>p</sub> × RT."},
{g:"hx",id:"EQH4",src:"Chemical Equilibrium · PCl<sub>5</sub>",topic:"Mass action",q:"K<sub>c</sub> = 0.04 for PCl<sub>5</sub>(g) ⇌ PCl<sub>3</sub>(g) + Cl<sub>2</sub>(g) at 250 °C. An equilibrium mixture has 0.20 mol PCl<sub>3</sub> and 0.12 mol Cl<sub>2</sub> in 4000 mL. Mass of PCl<sub>5</sub> (208.5 g/mol), in g?",ans:31.3,unit:"g",tol:.01,
 steps:["[PCl<sub>3</sub>] = 0.05 M, [Cl<sub>2</sub>] = 0.03 M.","[PCl<sub>5</sub>] = (0.05)(0.03)/0.04 = 0.0375 M.","Mass = 0.0375 × 208.5 × 4 = <b>31.3 g</b>."],why:"K<sub>c</sub> needs molarities, so divide moles by 4 L first."},
{g:"hx",id:"EQH5",src:"Chemical Equilibrium · SO<sub>2</sub>/SO<sub>3</sub> (a)",topic:"Mass action",q:"P(SO<sub>2</sub>) = 0.050, P(O<sub>2</sub>) = 0.025, P(SO<sub>3</sub>) = 1.00 atm at equilibrium. K<sub>p</sub> for 2SO<sub>2</sub> + O<sub>2</sub> ⇌ 2SO<sub>3</sub>?",ans:1.6e4,unit:"atm⁻¹",tol:.02,
 steps:["K<sub>p</sub> = (1.00)<sup>2</sup>/[(0.050)<sup>2</sup>(0.025)] = <b>1.6 × 10<sup>4</sup> atm<sup>−1</sup></b>."],why:"Exponents follow the coefficients."},
{g:"hx",id:"EQH6",src:"Chemical Equilibrium · SO<sub>2</sub>/SO<sub>3</sub> (b)",topic:"Mass action",q:"Same pressures. K<sub>p</sub> for SO<sub>2</sub> + ½O<sub>2</sub> ⇌ SO<sub>3</sub>?",ans:1.3e2,unit:"atm^−½",tol:.03,
 steps:["Halving the equation takes the square root: √(1.6 × 10<sup>4</sup>) = <b>1.3 × 10<sup>2</sup> atm<sup>−½</sup></b>."],why:"Multiply coefficients by n → K<sup>n</sup>; here n = ½."},
{g:"hx",id:"EQH7",src:"Chemical Equilibrium · Question 1a (ΔG°)",topic:"ΔG° and K",q:"ΔG° for N<sub>2</sub>O<sub>4</sub>(g) ⇌ 2NO<sub>2</sub>(g) at 298 K? ΔG°<sub>f</sub>: NO<sub>2</sub> 51.3, N<sub>2</sub>O<sub>4</sub> 99.8 kJ/mol.",ans:2.8,unit:"kJ/mol",tol:.02,
 steps:["ΔG° = 2(51.3) − 99.8 = <b>+2.8 kJ/mol</b>."],why:"Products minus reactants, times coefficients, just like ΔH°."},
{g:"hx",id:"EQH8",src:"Chemical Equilibrium · Question 1b (K)",topic:"ΔG° and K",q:"With ΔG° = 2.8 kJ/mol at 298 K, find K for N<sub>2</sub>O<sub>4</sub> ⇌ 2NO<sub>2</sub>.",ans:0.323,unit:"",tol:.02,
 steps:["ln K = −2800/(8.314 × 298) = −1.130.","K = e<sup>−1.130</sup> = <b>0.323</b>."],why:"Convert kJ to J. Positive ΔG° → K &lt; 1."},
{g:"hx",id:"EQH9",src:"Chemical Equilibrium · PCl<sub>5</sub> ΔG°",topic:"ΔG° and K",q:"K = 0.51 for the decomposition of PCl<sub>5</sub> at 500 K. ΔG° in kJ/mol?",ans:2.8,unit:"kJ/mol",tol:.02,
 steps:["ΔG° = −(8.314)(500) ln 0.51 = +2800 J/mol = <b>+2.8 kJ/mol</b>."],why:"ln of a number below 1 is negative, so −RT ln K is positive."}
];

