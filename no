 box(svg,20,24,280,96,nB,N,"Now: "+(N-nB)+" A (●), "+nB+" B (■)",7);box(svg,340,24,280,96,nBe,N,"At equilibrium: "+(N-nBe)+" A, "+nBe+" B",7);
 const L=40,R=600,y=190,X=v=>L+(R-L)*(clamp(v,-3.4,3.4)+3.5)/7;svg.appendChild(el("line",{x1:L,x2:R,y1:y,y2:y,class:"ax"}));
 for(let v=-3;v<=3;v++){svg.appendChild(el("line",{x1:X(v),x2:X(v),y1:y-4,y2:y+4,class:"ax"}));axisText(svg,X(v),y+20,v===0?"1":"10"+sup(v),{"text-anchor":"middle"})}
 const lq=Math.log10(Q);const dir=Math.abs(lq-lk)<0.02?0:lq<lk?1:-1;
 if(dir)arrow(svg,X(lq),y-16,X(lk)+(dir>0?-8:8),y-16,dir>0?"var(--good)":"var(--bad)",3);
 svg.appendChild(el("circle",{cx:X(lq),cy:y,r:7,fill:"var(--fg)"}));axisText(svg,X(lq),y+40,"Q",{"text-anchor":"middle",fill:"var(--fg)","font-weight":"700"});
 svg.appendChild(el("path",{d:"M"+X(lk)+","+(y-10)+" l8,10 l-8,10 l-8,-10Z",fill:"var(--accent)"}));axisText(svg,X(lk),y-26,"K",{"text-anchor":"middle",fill:"var(--accent)","font-weight":"700"});
 $("qkQ").textContent=nfmt(Q);$("qkKv").textContent=nfmt(K);$("qkD2").textContent=dir>0?"→ forward":dir<0?"← reverse":"at equilibrium";
 $("qkM").innerHTML=dir>0?"<b>Q &lt; K:</b> too little product for equilibrium. A converts to B until Q rises to K.":dir<0?"<b>Q &gt; K:</b> too much product. B converts back to A until Q falls to K.":"<b>Q = K:</b> no net change; forward and reverse rates are already equal."}
const mnus=s=>String(s).replace("-","−");
["qkK","qkB"].forEach(i=>$(i).addEventListener("input",drawQK));

// V3 Le Chatelier time graph (PCl5 <=> PCl3 + Cl2)
const LK=0.042;let lcS=null;
function eqShift(p5,p3,c2){const b=p3+c2+LK,c=p3*c2-LK*p5;return (-b+Math.sqrt(b*b-4*c))/2}
function drawLC2(){const svg=$("lc2C");clearSvg(svg);const x0=eqShift(0.30,0,0);const E0=[0.30-x0,x0,x0];let S=E0.slice(),msg="Choose a stress button. Predict the direction before you press it.",sh="—";
 if(lcS){const m={addCl2:[0,0,0.10],addPCl5:[0.10,0,0],remPCl3:[0,-x0/2,0]}[lcS];if(m)S=E0.map((v,i)=>v+m[i]);if(lcS==="halfV")S=E0.map(v=>v*2);if(lcS==="dblV")S=E0.map(v=>v/2)}
 const y=eqShift(...S),E1=[S[0]-y,S[1]+y,S[2]+y],Q=S[1]*S[2]/S[0];
 const L=56,R=620,T=14,B=240,ts=10,tm=40,X=t=>L+(R-L)*t/tm,mx=Math.max(...E0,...S,...E1)*1.15,Y=c=>B-(B-T)*c/mx;
 gridY(svg,L,R,Y,[0,+(mx/2).toFixed(2),+(mx*0.95).toFixed(2)]);axisText(svg,R,B+18,"time →",{"text-anchor":"end"});axisText(svg,L+4,T+12,"M");
 if(lcS){svg.appendChild(el("line",{x1:X(ts),x2:X(ts),y1:T,y2:B,stroke:"var(--muted)","stroke-dasharray":"4 4"}));axisText(svg,X(ts)+4,B-6,"stress")}
 const col=["var(--violet)","var(--good)","var(--warn)"],nm=["PCl₅","PCl₃","Cl₂"];
 [0,1,2].forEach(i=>{const pts=[];for(let j=0;j<=200;j++){const t=tm*j/200;let v;if(!lcS||t<ts)v=E0[i];else v=E1[i]+(S[i]-E1[i])*Math.exp(-(t-ts)*0.35);pts.push([t,v])}
  if(lcS)pts.splice(pts.findIndex(p=>p[0]>=ts),0,[ts,E0[i]],[ts,S[i]]);
  svg.appendChild(el("path",{d:pathOf(pts,X,Y),fill:"none",stroke:col[i],"stroke-width":2.5,"stroke-dasharray":i===2?"7 4":"none"}));
  axisText(svg,R-2,Y(lcS?E1[i]:E0[i])+(i===2?14:-6),nm[i],{"text-anchor":"end",fill:col[i],"font-weight":"700"})});
 if(lcS){sh=Math.abs(y)<1e-6?"none":y>0?"→ right":"← left";
  const t={addCl2:"Cl₂ jumps up, so Q &gt; K. The reaction runs in reverse: Cl₂ and PCl₃ drop together and PCl₅ rises. The new [Cl₂] stays higher than before: the stress is only partly removed.",
   addPCl5:"PCl₅ jumps, so Q &lt; K. Some PCl₅ decomposes, and PCl₃ and Cl₂ climb together (they rise by equal amounts, 1:1).",
   remPCl3:"PCl₃ drops, so Q &lt; K. More PCl₅ decomposes to replace part of it; Cl₂ rises along with it.",
   halfV:"Every concentration doubles at once (the vertical jump on all three lines). Q = 2K, so the system shifts left toward fewer gas moles (1 vs 2).",
   dblV:"Every concentration halves. Q = K/2, so the system shifts right toward more gas moles."}[lcS];msg=t+" K stays 0.042: check that (PCl₃)(Cl₂)/(PCl₅) = "+(E1[1]*E1[2]/E1[0]).toFixed(3)+" at the end."}
 $("lc2Q").textContent=Q.toFixed(3);$("lc2S").textContent=sh;$("lc2M").innerHTML=msg}
document.querySelectorAll("#lc2B [data-s]").forEach(b=>b.onclick=()=>{lcS=b.dataset.s;drawLC2()});


