  --display:"Archivo",ui-sans-serif,system-ui,sans-serif;
  --body:"Literata",Georgia,"Times New Roman",serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
  --ui:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#13110f; --surface:#1c1915; --sunk:#25211c; --fg:#ece7e0; --muted:#a69d92; --line:#352f28;
  --accent:#ff8a57; --accent-soft:#3a2216; --good:#5fd39a; --good-soft:#14301f; --bad:#ff8a80; --bad-soft:#3a1715; --warn:#f2c35b; --warn-soft:#352812;
  --hot:#ff7a4d; --hot-soft:#3b1d12; --cold:#6fa8ef; --cold-soft:#15253a; --violet:#a98cf0; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#13110f; --surface:#1c1915; --sunk:#25211c; --fg:#ece7e0; --muted:#a69d92; --line:#352f28;
  --accent:#ff8a57; --accent-soft:#3a2216; --good:#5fd39a; --good-soft:#14301f; --bad:#ff8a80; --bad-soft:#3a1715; --warn:#f2c35b; --warn-soft:#352812;
  --hot:#ff7a4d; --hot-soft:#3b1d12; --cold:#6fa8ef; --cold-soft:#15253a; --violet:#a98cf0; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth;scroll-padding-top:72px}
